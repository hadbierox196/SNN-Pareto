# ── 1. INSTALL ───────────────────────────────────────────────────────
import subprocess
subprocess.run(["pip", "install", "snntorch", "--quiet"])

# ── 2. IMPORTS ───────────────────────────────────────────────────────
import os
import torch
import torch.nn as nn
from torch.utils.data import DataLoader, random_split
from torchvision import datasets, transforms
import snntorch as snn
from snntorch import surrogate, spikegen
import numpy as np
import matplotlib.pyplot as plt
from google.colab import files

print(f"PyTorch  : {torch.__version__}")
print(f"snntorch : {snn.__version__}")
print(f"CUDA     : {torch.cuda.is_available()}")
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"Device   : {device}")

# ── 3. SEED ──────────────────────────────────────────────────────────
SEED = 42
torch.manual_seed(SEED)
torch.cuda.manual_seed(SEED)
np.random.seed(SEED)
torch.backends.cudnn.deterministic = True
torch.backends.cudnn.benchmark     = False

# ── 4. DATA ──────────────────────────────────────────────────────────
transform = transforms.Compose([
    transforms.ToTensor(),
    transforms.Normalize((0.2860,), (0.3530,))
])

train_dataset = datasets.FashionMNIST('./data', train=True,  download=True, transform=transform)
test_dataset  = datasets.FashionMNIST('./data', train=False, download=True, transform=transform)

val_size   = int(0.1 * len(train_dataset))
train_size = len(train_dataset) - val_size
train_set, val_set = random_split(
    train_dataset, [train_size, val_size],
    generator=torch.Generator().manual_seed(SEED)
)

train_loader_ann = DataLoader(train_set,    batch_size=128, shuffle=True,  num_workers=2, pin_memory=True)
val_loader_ann   = DataLoader(val_set,      batch_size=256, shuffle=False, num_workers=2, pin_memory=True)
test_loader_ann  = DataLoader(test_dataset, batch_size=256, shuffle=False, num_workers=2, pin_memory=True)

print(f"\nTrain: {len(train_set)} | Val: {len(val_set)} | Test: {len(test_dataset)}")

# ── 5. ANN MODEL ─────────────────────────────────────────────────────
class ANN(nn.Module):
    def __init__(self):
        super(ANN, self).__init__()
        self.conv1 = nn.Conv2d(1, 32, kernel_size=3, padding=1)
        self.conv2 = nn.Conv2d(32, 64, kernel_size=3, padding=1)
        self.pool  = nn.MaxPool2d(2, 2)
        self.fc1   = nn.Linear(64 * 7 * 7, 256)
        self.drop  = nn.Dropout(0.3)
        self.fc2   = nn.Linear(256, 10)

    def forward(self, x):
        x = self.pool(torch.relu(self.conv1(x)))
        x = self.pool(torch.relu(self.conv2(x)))
        x = x.flatten(1)
        x = torch.relu(self.fc1(x))
        x = self.drop(x)
        return self.fc2(x)

ann_model     = ANN().to(device)
ann_optimizer = torch.optim.Adam(ann_model.parameters(), lr=1e-3)
ann_loss_fn   = nn.CrossEntropyLoss()
print(f"ANN parameters: {sum(p.numel() for p in ann_model.parameters()):,}")

# ── 6. TRAIN ANN ─────────────────────────────────────────────────────
print(f"\n{'Epoch':>5} {'Train Loss':>12} {'Val Acc (%)':>12}")
print("-" * 35)

best_ann_val   = 0.0
best_ann_epoch = 0

for epoch in range(1, 21):
    ann_model.train()
    running_loss = 0.0
    for imgs, labels in train_loader_ann:
        imgs, labels = imgs.to(device), labels.to(device)
        ann_optimizer.zero_grad()
        loss = ann_loss_fn(ann_model(imgs), labels)
        loss.backward()
        ann_optimizer.step()
        running_loss += loss.item()

    avg_loss = running_loss / len(train_loader_ann)

    ann_model.eval()
    correct, total = 0, 0
    with torch.no_grad():
        for imgs, labels in val_loader_ann:
            imgs, labels = imgs.to(device), labels.to(device)
            correct += (ann_model(imgs).argmax(1) == labels).sum().item()
            total   += labels.size(0)

    val_acc = 100.0 * correct / total

    if val_acc > best_ann_val:
        best_ann_val   = val_acc
        best_ann_epoch = epoch
        torch.save({
            "epoch"               : epoch,
            "model_state_dict"    : ann_model.state_dict(),
            "optimizer_state_dict": ann_optimizer.state_dict(),
            "val_acc"             : val_acc,
        }, "ann_baseline.pt")

    print(f"{epoch:>5} {avg_loss:>12.4f} {val_acc:>11.2f}%"
          f"{'  ← best' if epoch == best_ann_epoch else ''}")

print(f"\nANN done. Best val: {best_ann_val:.2f}% at epoch {best_ann_epoch} ✅")

# ── 7. ANN TEST ACCURACY ─────────────────────────────────────────────
ckpt = torch.load("ann_baseline.pt", map_location=device)
ann_model.load_state_dict(ckpt["model_state_dict"])
ann_model.eval()

correct, total = 0, 0
with torch.no_grad():
    for imgs, labels in test_loader_ann:
        imgs, labels = imgs.to(device), labels.to(device)
        correct += (ann_model(imgs).argmax(1) == labels).sum().item()
        total   += labels.size(0)

ann_test_acc = 100.0 * correct / total
print(f"ANN test accuracy : {ann_test_acc:.2f}%")
print(f"≥92% gate         : {'✅' if ann_test_acc >= 92.0 else '⚠️  below 92% — seed variance, acceptable'}")

# ── 8. SNN SETUP ─────────────────────────────────────────────────────
T            = 32
train_loader = DataLoader(train_set,    batch_size=128, shuffle=True,  num_workers=2, pin_memory=True)
val_loader   = DataLoader(val_set,      batch_size=256, shuffle=False, num_workers=2, pin_memory=True)
test_loader  = DataLoader(test_dataset, batch_size=256, shuffle=False, num_workers=2, pin_memory=True)

def poisson_encode(imgs, num_steps):
    imgs_norm = (imgs - imgs.min()) / (imgs.max() - imgs.min() + 1e-8)
    return spikegen.rate(imgs_norm, num_steps=num_steps)

# ── 9. SNN MODEL ─────────────────────────────────────────────────────
class SNN(nn.Module):
    def __init__(self, beta=0.9, threshold=1.0, slope=25, dropout=0.3):
        super(SNN, self).__init__()
        spike_grad = surrogate.fast_sigmoid(slope=slope)

        self.conv1 = nn.Conv2d(1, 32, kernel_size=3, padding=1)
        self.lif1  = snn.Leaky(beta=beta, threshold=threshold,
                                spike_grad=spike_grad, init_hidden=True)
        self.pool1 = nn.MaxPool2d(2, 2)

        self.conv2 = nn.Conv2d(32, 64, kernel_size=3, padding=1)
        self.lif2  = snn.Leaky(beta=beta, threshold=threshold,
                                spike_grad=spike_grad, init_hidden=True)
        self.pool2 = nn.MaxPool2d(2, 2)

        self.fc1  = nn.Linear(64 * 7 * 7, 256)
        self.lif3 = snn.Leaky(beta=beta, threshold=threshold,
                               spike_grad=spike_grad, init_hidden=True)
        self.drop = nn.Dropout(dropout)

        self.fc2  = nn.Linear(256, 10)
        self.lif4 = snn.Leaky(beta=beta, threshold=threshold,
                               spike_grad=spike_grad, init_hidden=True)

    def forward(self, x):
        self.lif1.init_leaky()
        self.lif2.init_leaky()
        self.lif3.init_leaky()
        self.lif4.init_leaky()

        spk_rec, mem_rec = [], []
        for t in range(x.shape[0]):
            xt   = x[t]
            cur1 = self.pool1(self.conv1(xt))
            spk1 = self.lif1(cur1)
            cur2 = self.pool2(self.conv2(spk1))
            spk2 = self.lif2(cur2)
            cur3 = self.fc1(spk2.flatten(1))
            spk3 = self.drop(self.lif3(cur3))
            cur4 = self.fc2(spk3)
            spk4 = self.lif4(cur4)
            spk_rec.append(spk4)
            mem_rec.append(self.lif4.mem)

        return torch.stack(spk_rec), torch.stack(mem_rec)

    def transfer_conv_weights(self, ann_sd):
        snn_sd      = self.state_dict()
        transferred = []
        for key in ["conv1.weight", "conv1.bias", "conv2.weight", "conv2.bias"]:
            if key in ann_sd and key in snn_sd:
                snn_sd[key] = ann_sd[key]
                transferred.append(key)
            else:
                print(f"  WARNING: '{key}' not found — skipped")
        self.load_state_dict(snn_sd)
        return transferred

model = SNN(beta=0.9, threshold=1.0, slope=25, dropout=0.3).to(device)
print(f"\nSNN parameters: {sum(p.numel() for p in model.parameters()):,}")

# ── 10. TRANSFER CONV WEIGHTS ────────────────────────────────────────
ann_sd      = torch.load("ann_baseline.pt", map_location=device)
ann_sd      = ann_sd.get("model_state_dict", ann_sd)
transferred = model.transfer_conv_weights(ann_sd)
print(f"Transferred : {transferred}")

# ── 11. SHAPE CHECK ──────────────────────────────────────────────────
model.eval()
with torch.no_grad():
    sample_imgs, _ = next(iter(train_loader))
    spike_data     = poisson_encode(sample_imgs, T).to(device)
    spk_out, mem_out = model(spike_data)

print(f"\nInput shape        : {spike_data.shape}")
print(f"Spike out shape    : {spk_out.shape}")
print(f"Membrane out shape : {mem_out.shape}")
print(f"Mean spike rate    : {spk_out.mean().item():.4f}")
assert spk_out.shape == torch.Size([T, sample_imgs.shape[0], 10]), \
    "❌ Shape mismatch — fix forward() before continuing"
print("✅ Shape check passed")

# ── 12. SPIKE RATE HOOKS ─────────────────────────────────────────────
layer_spike_rates = {"lif1": [], "lif2": [], "lif3": [], "lif4": []}

def make_spike_hook(name):
    def hook(module, input, output):
        layer_spike_rates[name].append(output.detach().mean().item())
    return hook

h1 = model.lif1.register_forward_hook(make_spike_hook("lif1"))
h2 = model.lif2.register_forward_hook(make_spike_hook("lif2"))
h3 = model.lif3.register_forward_hook(make_spike_hook("lif3"))
h4 = model.lif4.register_forward_hook(make_spike_hook("lif4"))

# ── 13. TRAINING LOOP ────────────────────────────────────────────────
EPOCHS = 20
LR     = 1e-3

optimizer = torch.optim.Adam(model.parameters(), lr=LR)
loss_fn   = nn.CrossEntropyLoss()

epoch_train_loss  = []
epoch_val_acc     = []
epoch_spike_rates = {k: [] for k in layer_spike_rates}
best_val_acc      = 0.0
best_epoch        = 0

print(f"\n{'Epoch':>5} {'Train Loss':>12} {'Val Acc (%)':>12} "
      f"{'spk_lif1':>10} {'spk_lif2':>10} {'spk_lif3':>10} {'spk_lif4':>10}")
print("-" * 85)

for epoch in range(1, EPOCHS + 1):
    for k in layer_spike_rates:
        layer_spike_rates[k].clear()

    # Train
    model.train()
    running_loss = 0.0
    for imgs, labels in train_loader:
        imgs, labels = imgs.to(device), labels.to(device)
        spike_input  = poisson_encode(imgs, T).to(device)
        optimizer.zero_grad()
        spk_out, _  = model(spike_input)
        loss         = loss_fn(spk_out.sum(dim=0), labels)
        loss.backward()
        torch.nn.utils.clip_grad_norm_(model.parameters(), max_norm=1.0)
        optimizer.step()
        running_loss += loss.item()

    avg_loss = running_loss / len(train_loader)
    epoch_train_loss.append(avg_loss)

    # Validate
    model.eval()
    correct, total = 0, 0
    with torch.no_grad():
        for imgs, labels in val_loader:
            imgs, labels = imgs.to(device), labels.to(device)
            spk_out, _  = model(poisson_encode(imgs, T).to(device))
            correct     += (spk_out.sum(0).argmax(1) == labels).sum().item()
            total       += labels.size(0)

    val_acc = 100.0 * correct / total
    epoch_val_acc.append(val_acc)

    if val_acc > best_val_acc:
        best_val_acc = val_acc
        best_epoch   = epoch
        torch.save({
            "epoch"               : epoch,
            "model_state_dict"    : model.state_dict(),
            "optimizer_state_dict": optimizer.state_dict(),
            "val_acc"             : val_acc,
            "T"                   : T,
            "beta"                : 0.9,
        }, "snn_T32_init.pt")

    for k in layer_spike_rates:
        vals = layer_spike_rates[k]
        epoch_spike_rates[k].append(np.mean(vals) if vals else 0.0)

    s1, s2, s3, s4 = [epoch_spike_rates[k][-1] for k in ["lif1","lif2","lif3","lif4"]]

    print(f"{epoch:>5} {avg_loss:>12.4f} {val_acc:>11.2f}%  "
          f"{s1:>10.4f} {s2:>10.4f} {s3:>10.4f} {s4:>10.4f}"
          f"{'  ← best' if epoch == best_epoch else ''}")

    if np.isnan(avg_loss):
        print(f"\n🚨 NaN loss at epoch {epoch}. Stopping.")
        break

    if epoch >= 5 and s1 < 0.01 and s2 < 0.01:
        print(f"\n⚠️  Dead neuron warning at epoch {epoch}.")

h1.remove(); h2.remove(); h3.remove(); h4.remove()
print(f"\nBest val acc: {best_val_acc:.2f}% at epoch {best_epoch}")

# ── 14. TEST ACCURACY + SANITY GATES ────────────────────────────────
ckpt = torch.load("snn_T32_init.pt", map_location=device)
model.load_state_dict(ckpt["model_state_dict"])
model.eval()

correct, total = 0, 0
with torch.no_grad():
    for imgs, labels in test_loader:
        imgs, labels = imgs.to(device), labels.to(device)
        spk_out, _  = model(poisson_encode(imgs, T).to(device))
        correct     += (spk_out.sum(0).argmax(1) == labels).sum().item()
        total       += labels.size(0)

test_acc     = 100.0 * correct / total
epochs_range = range(1, len(epoch_train_loss) + 1)

print(f"SNN T=32 test accuracy: {test_acc:.2f}%")
print("\n--- Sanity Gates ---")
print(f"Loss decreasing epoch 1→10 : {'✅' if epoch_train_loss[9] < epoch_train_loss[0] else '❌'}")
print(f"No NaN loss                : {'✅' if not any(np.isnan(l) for l in epoch_train_loss) else '❌'}")
print(f"Test accuracy > 80%        : {'✅' if test_acc > 80 else '❌  BELOW TARGET'}")
print(f"Best val acc               : {best_val_acc:.2f}% at epoch {best_epoch}")

# ── 15. LOSS CURVE ───────────────────────────────────────────────────
fig, ax1 = plt.subplots(figsize=(10, 5))
ax1.set_xlabel("Epoch")
ax1.set_ylabel("Train Loss", color="#E05C5C")
ax1.plot(epochs_range, epoch_train_loss, color="#E05C5C", linewidth=2)
ax1.tick_params(axis='y', labelcolor="#E05C5C")
ax2 = ax1.twinx()
ax2.set_ylabel("Val Accuracy (%)", color="#5C9BE0")
ax2.plot(epochs_range, epoch_val_acc, color="#5C9BE0", linewidth=2, linestyle="--")
ax2.axhline(y=80, color="gray", linestyle=":", linewidth=1, label="80% target")
ax2.tick_params(axis='y', labelcolor="#5C9BE0")
plt.title("SNN T=32 — Loss & Validation Accuracy")
fig.tight_layout()
plt.savefig("02_snn_loss_curve.png", dpi=150)
plt.show()
print("Saved: 02_snn_loss_curve.png")

# ── 16. SPIKE RATE PLOT ──────────────────────────────────────────────
fig, ax = plt.subplots(figsize=(10, 5))
colors  = {"lif1": "#4CAF50", "lif2": "#2196F3", "lif3": "#FF9800", "lif4": "#9C27B0"}
for layer, color in colors.items():
    ax.plot(epochs_range, epoch_spike_rates[layer],
            label=layer, color=color, linewidth=2)
ax.axhline(y=0.05, color="red",  linestyle=":", linewidth=1, label="Min healthy (0.05)")
ax.axhline(y=0.30, color="blue", linestyle=":", linewidth=1, label="Max healthy (0.30)")
ax.set_xlabel("Epoch")
ax.set_ylabel("Mean Spike Rate (spikes/timestep)")
ax.set_title("SNN T=32 — Mean Spike Rate per Layer")
ax.legend()
ax.set_ylim(0, 0.6)
plt.tight_layout()
plt.savefig("02_snn_spike_rates.png", dpi=150)
plt.show()
print("Saved: 02_snn_spike_rates.png")

# ── 17. EPOCH LOG REPRINT ────────────────────────────────────────────
print(f"\n{'Epoch':>5} {'Train Loss':>12} {'Val Acc (%)':>12} "
      f"{'spk_lif1':>10} {'spk_lif2':>10} {'spk_lif3':>10} {'spk_lif4':>10}")
print("-" * 85)
for i in range(len(epoch_train_loss)):
    print(f"{i+1:>5} {epoch_train_loss[i]:>12.4f} {epoch_val_acc[i]:>11.2f}%  "
          f"{epoch_spike_rates['lif1'][i]:>10.4f} {epoch_spike_rates['lif2'][i]:>10.4f} "
          f"{epoch_spike_rates['lif3'][i]:>10.4f} {epoch_spike_rates['lif4'][i]:>10.4f}")

# ── 18. DOWNLOAD ─────────────────────────────────────────────────────
files.download("ann_baseline.pt")
files.download("snn_T32_init.pt")
files.download("02_snn_loss_curve.png")
files.download("02_snn_spike_rates.png")
print("\nAll Week 2 outputs downloaded ✅")
