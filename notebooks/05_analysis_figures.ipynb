# Week 5 — Pareto Frontier and Marginal Analysis
# All cells combined — copy-paste ready
# ═══════════════════════════════════════════════════════════════════

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# ── Global style constants ────────────────────────────────────────
FONT_SIZE      = 13
TITLE_SIZE     = 12
LABEL_SIZE     = 13
TICK_SIZE      = 11
LEGEND_SIZE    = 10
FIG_SIZE       = (6.5, 5.0)
SNN_COLOR      = 'steelblue'
SNN_OFF_COLOR  = '#a0b8cc'
ANN_COLOR      = 'crimson'
MARGINAL_COLOR = 'darkorange'
SHADE_COLOR    = '#ffe0b2'

plt.rcParams.update({
    'font.size'      : FONT_SIZE,
    'font.family'    : 'sans-serif',
    'axes.titlesize' : TITLE_SIZE,
    'axes.labelsize' : LABEL_SIZE,
    'xtick.labelsize': TICK_SIZE,
    'ytick.labelsize': TICK_SIZE,
    'legend.fontsize': LEGEND_SIZE,
    'figure.dpi'     : 150,
})


# ═══════════════════════════════════════════════════════════════════
# CELL 1 — Load and split CSV
# ═══════════════════════════════════════════════════════════════════

df  = pd.read_csv('sweep_results_complete__1_.csv')
snn = df[df['T'].notna()].copy()
ann = df[df['T'].isna()].copy()

print(f"SNN rows: {len(snn)}")
print(f"ANN rows: {len(ann)}")
print(snn.head())


# ═══════════════════════════════════════════════════════════════════
# CELL 2 — Aggregate mean ± std per T
# ═══════════════════════════════════════════════════════════════════

grouped = snn.groupby('T').agg(
    acc_mean   =('accuracy',  'mean'),
    acc_std    =('accuracy',  'std'),
    energy_mean=('energy_nj', 'mean'),
    energy_std =('energy_nj', 'std')
).reset_index()

ann_acc_mean    = ann['accuracy'].mean()
ann_energy_mean = ann['energy_nj'].mean()

print(grouped.to_string(index=False))
print(f"\nANN mean accuracy: {ann_acc_mean:.2f}%")
print(f"ANN mean energy:   {ann_energy_mean:.2f} nJ")


# ═══════════════════════════════════════════════════════════════════
# CELL 3 — Helper functions
# ═══════════════════════════════════════════════════════════════════

def pareto_indices(costs, accs):
    pareto = []
    for i, (c, a) in enumerate(zip(costs, accs)):
        dominated = any(
            costs[j] <= c and accs[j] >= a and
            (costs[j] < c or accs[j] > a)
            for j in range(len(costs)) if j != i
        )
        if not dominated:
            pareto.append(i)
    return pareto


def compute_marginal(grouped):
    g = grouped.sort_values('T').reset_index(drop=True)
    marginal_T, marginal_gain, marginal_err = [], [], []
    for i in range(1, len(g)):
        delta = g.loc[i, 'acc_mean'] - g.loc[i - 1, 'acc_mean']
        err   = np.sqrt(g.loc[i, 'acc_std'] ** 2 +
                        g.loc[i - 1, 'acc_std'] ** 2)
        marginal_T.append(int(g.loc[i, 'T']))
        marginal_gain.append(delta)
        marginal_err.append(err)
    return np.array(marginal_T), np.array(marginal_gain), np.array(marginal_err)


# ═══════════════════════════════════════════════════════════════════
# CELL 4 — Pareto frontier + marginal gain verification print
# ═══════════════════════════════════════════════════════════════════

costs  = grouped['energy_mean'].values
accs   = grouped['acc_mean'].values
T_vals = grouped['T'].values
pidx   = pareto_indices(costs, accs)

print("Pareto-non-dominated T values:", [T_vals[i] for i in pidx])

marginal_T, marginal_gain, marginal_err = compute_marginal(grouped)

print(f"\n{'T':<6} | {'ΔAcc/Δlog₂T':>12} | {'PropErr':>10}")
print("-" * 36)
for t, g, e in zip(marginal_T, marginal_gain, marginal_err):
    print(f"T={t:<4} | {g:+.3f}%      | ±{e:.3f}%")

print(f"\nT=8  energy saving vs ANN: "
      f"{ann_energy_mean / grouped[grouped['T']==8]['energy_mean'].values[0]:.1f}×")
print(f"T=4  energy saving vs ANN: "
      f"{ann_energy_mean / grouped[grouped['T']==4]['energy_mean'].values[0]:.1f}×")
print(f"T=64 energy vs ANN: "
      f"{grouped[grouped['T']==64]['energy_mean'].values[0]:.1f} nJ "
      f"vs {ann_energy_mean:.1f} nJ")


# ═══════════════════════════════════════════════════════════════════
# CELL 5 — Figure 1: Energy–Accuracy Pareto Frontier
# ═══════════════════════════════════════════════════════════════════

on_front  = set(pidx)
off_idx   = [i for i in range(len(grouped)) if i not in on_front]

fig1, ax1 = plt.subplots(figsize=FIG_SIZE)

# Off-frontier points — hollow circles
if off_idx:
    off = grouped.iloc[off_idx]
    ax1.errorbar(
        off['energy_mean'], off['acc_mean'],
        xerr=off['energy_std'], yerr=off['acc_std'],
        fmt='o', color='white', ecolor=SNN_OFF_COLOR,
        elinewidth=1.1, capsize=3, markersize=7,
        markeredgecolor=SNN_OFF_COLOR, markeredgewidth=1.4,
        label='SNN (off frontier)', zorder=3
    )

# On-frontier points — filled circles
on = grouped.iloc[sorted(on_front)]
ax1.errorbar(
    on['energy_mean'], on['acc_mean'],
    xerr=on['energy_std'], yerr=on['acc_std'],
    fmt='o', color=SNN_COLOR, ecolor=SNN_COLOR,
    elinewidth=1.1, capsize=3, markersize=7,
    label='SNN (Pareto frontier)', zorder=4
)

# Pareto dashed line — stops at T=8 (T=32 technically non-dominated
# but 0.24% gain for 2× energy is not practically meaningful)
core_front = grouped[grouped['T'].isin([1, 2, 4, 8])].sort_values('energy_mean')
ax1.plot(
    core_front['energy_mean'], core_front['acc_mean'],
    '--', color=SNN_COLOR, linewidth=1.4,
    label='Pareto frontier (T=1→8)', zorder=2
)

# ANN star
ax1.scatter(
    ann_energy_mean, ann_acc_mean,
    marker='*', s=240, color=ANN_COLOR, zorder=5,
    label=f'ANN baseline ({ann_acc_mean:.2f}%)'
)
ax1.annotate(
    'ANN',
    xy=(ann_energy_mean, ann_acc_mean),
    xytext=(7, -14), textcoords='offset points',
    fontsize=10, color=ANN_COLOR
)

# Per-point T labels — individually offset to avoid overlap on log scale
label_offsets = {
    1:  ( 6,   5),
    2:  ( 6,   5),
    4:  ( 6, -14),
    8:  ( 6,   5),
    16: ( 6, -14),
    32: ( 6,   5),
    64: ( 6, -14),
}
for _, row in grouped.iterrows():
    t      = int(row['T'])
    dx, dy = label_offsets.get(t, (6, 4))
    ax1.annotate(
        f'T={t}',
        xy=(row['energy_mean'], row['acc_mean']),
        xytext=(dx, dy), textcoords='offset points',
        fontsize=9,
        color=SNN_COLOR if t in [1, 2, 4, 8] else SNN_OFF_COLOR
    )

ax1.set_xscale('log')
ax1.set_xlabel('Estimated Energy (nJ, log scale)', fontsize=LABEL_SIZE)
ax1.set_ylabel('Test Accuracy (%)', fontsize=LABEL_SIZE)
ax1.text(0.02, 0.97, 'A', transform=ax1.transAxes,
         fontsize=15, fontweight='bold', va='top', ha='left')
ax1.set_title(
    'Energy–Accuracy Pareto Frontier\n(Fashion-MNIST, 3 seeds per T)',
    fontsize=TITLE_SIZE
)
ax1.legend(fontsize=LEGEND_SIZE, loc='lower right')
ax1.grid(True, linestyle=':', alpha=0.5)

plt.tight_layout()
plt.savefig('fig1_pareto.png', dpi=300, bbox_inches='tight')
plt.show()
print("Saved fig1_pareto.png")


# ═══════════════════════════════════════════════════════════════════
# CELL 6 — Figure 2: Marginal Accuracy Gain
# ═══════════════════════════════════════════════════════════════════

fig2, ax2 = plt.subplots(figsize=FIG_SIZE)

# Shaded negligible-gain zone below 0.5%
ax2.axhspan(-0.8, 0.5, color=SHADE_COLOR, alpha=0.35, zorder=0,
            label='Negligible gain zone (< 0.5%)')

# 0.5% threshold line
ax2.axhline(0.5, color='gray', linestyle='--', linewidth=1.3, zorder=2,
            label='0.5% threshold (T* criterion)')

# 0% reference
ax2.axhline(0.0, color='black', linestyle=':', linewidth=0.8, zorder=1)

# Marginal gain curve with propagated error bars
ax2.errorbar(
    marginal_T, marginal_gain,
    yerr=marginal_err,
    fmt='o-', color=MARGINAL_COLOR, ecolor=MARGINAL_COLOR,
    elinewidth=1.2, capsize=3, markersize=7,
    label='ΔAcc / Δlog₂T', zorder=3
)

# T*=8 annotation — arrow curved from label down to the T=8 point
t_star_idx = np.where(marginal_T == 8)[0][0]
ax2.annotate(
    'T* = 8 (elbow)\nlast point > 0.5%',
    xy=(marginal_T[t_star_idx], marginal_gain[t_star_idx]),
    xytext=(14, 38), textcoords='offset points',
    fontsize=9, color=MARGINAL_COLOR,
    arrowprops=dict(
        arrowstyle='->', color=MARGINAL_COLOR,
        lw=1.1, connectionstyle='arc3,rad=0.2'
    )
)

# x-axis: T value + log₂T in parentheses on second line
log2_labels = {
    2:  '2\n(log₂T=1)',
    4:  '4\n(log₂T=2)',
    8:  '8\n(log₂T=3)',
    16: '16\n(log₂T=4)',
    32: '32\n(log₂T=5)',
    64: '64\n(log₂T=6)',
}
ax2.set_xscale('log', base=2)
ax2.set_xticks(marginal_T)
ax2.set_xticklabels(
    [log2_labels.get(t, str(t)) for t in marginal_T],
    fontsize=9
)

ax2.set_xlabel('Timestep T', fontsize=LABEL_SIZE)
ax2.set_ylabel('ΔAccuracy per doubling of T (%)', fontsize=LABEL_SIZE)
ax2.text(0.02, 0.97, 'B', transform=ax2.transAxes,
         fontsize=15, fontweight='bold', va='top', ha='left')
ax2.set_title(
    'Marginal Accuracy Gain per Timestep Doubling\n(Fashion-MNIST, 3 seeds per T)',
    fontsize=TITLE_SIZE
)
ax2.legend(fontsize=LEGEND_SIZE, loc='upper right')
ax2.grid(True, linestyle=':', alpha=0.5)

plt.tight_layout()
plt.savefig('fig2_marginal.png', dpi=300, bbox_inches='tight')
plt.show()
print("Saved fig2_marginal.png")


# ═══════════════════════════════════════════════════════════════════
# CELL 7 — Print figure captions
# ═══════════════════════════════════════════════════════════════════

