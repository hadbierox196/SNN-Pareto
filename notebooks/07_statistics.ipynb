# ────────────────────────────────────────────────────────────────────────
# CELL 1 — Imports and CSV upload
# ────────────────────────────────────────────────────────────────────────

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy import stats
from google.colab import files
import io, os

OUT_DIR = '/content/results'
os.makedirs(OUT_DIR, exist_ok=True)

print("Select sweep_results_complete__1_.csv when the dialog opens...")
uploaded  = files.upload()
filename  = list(uploaded.keys())[0]
CSV_BYTES = uploaded[filename]

CSV_FILE = f'/content/{filename}'
with open(CSV_FILE, 'wb') as f:
    f.write(CSV_BYTES)

print(f"\nUploaded : {filename}")
print(f"Saved at : {CSV_FILE}")
print(f"Output   : {OUT_DIR}")


# ────────────────────────────────────────────────────────────────────────
# CELL 2 — Load and validate CSV
# ────────────────────────────────────────────────────────────────────────

df = pd.read_csv(CSV_FILE)
print(f"Loaded {len(df)} rows, columns: {list(df.columns)}")
print(df.head(6))
print(f"\nUnique T values : {sorted(df['T'].dropna().unique())}")
print(f"NaN T rows (ANN): {df['T'].isna().sum()}")

snn = df[df['T'].notna()].copy()
ann = df[df['T'].isna()].copy()
snn['T'] = snn['T'].astype(int)

print(f"\nSNN rows : {len(snn)}  (expected 21)")
print(f"ANN rows : {len(ann)}  (expected 3)")


# ────────────────────────────────────────────────────────────────────────
# CELL 3 — Bootstrap CI function
# ────────────────────────────────────────────────────────────────────────

def bootstrap_ci(data, n_boot=1000, ci=0.95):
    """
    Percentile bootstrap 95% CI.
    With only n=3 seeds this is an approximation —
    report this limitation explicitly in the paper.
    """
    rng  = np.random.default_rng(seed=42)
    data = np.array(data)
    boots = [np.mean(rng.choice(data, size=len(data), replace=True))
             for _ in range(n_boot)]
    lo = np.percentile(boots, (1 - ci) / 2 * 100)
    hi = np.percentile(boots, (1 + ci) / 2 * 100)
    return lo, hi

# Smoke test
_test = [89.66, 89.85, 89.57]
lo, hi = bootstrap_ci(_test)
print(f"Smoke test T=8 accuracy CI: [{lo:.4f}, {hi:.4f}]")
print("(Wide interval with n=3 is expected)")


# ────────────────────────────────────────────────────────────────────────
# CELL 4 — Per-T aggregation with bootstrap CIs
# ────────────────────────────────────────────────────────────────────────

T_VALUES = sorted(snn['T'].unique())
rows = []

for T in T_VALUES:
    grp         = snn[snn['T'] == T]
    acc_vals    = grp['accuracy'].values
    energy_vals = grp['energy_nj'].values

    acc_lo, acc_hi = bootstrap_ci(acc_vals)
    e_lo,   e_hi   = bootstrap_ci(energy_vals)

    rows.append({
        'T'            : T,
        'acc_mean'     : round(acc_vals.mean(),       4),
        'acc_std'      : round(acc_vals.std(ddof=1),  4),
        'acc_ci_lo'    : round(acc_lo,  4),
        'acc_ci_hi'    : round(acc_hi,  4),
        'energy_mean'  : round(energy_vals.mean(),      2),
        'energy_std'   : round(energy_vals.std(ddof=1), 2),
        'energy_ci_lo' : round(e_lo,    2),
        'energy_ci_hi' : round(e_hi,    2),
    })

stats_df = pd.DataFrame(rows)
print(stats_df.to_string(index=False))


# ────────────────────────────────────────────────────────────────────────
# CELL 5 — ANN reference stats
# ────────────────────────────────────────────────────────────────────────

ann_acc    = ann['accuracy'].values
ann_energy = ann['energy_nj'].values

ann_acc_mean           = ann_acc.mean()
ann_acc_lo, ann_acc_hi = bootstrap_ci(ann_acc)
ann_e_mean             = ann_energy.mean()   # fixed — identical MAC count

print("── ANN Reference ───────────────────────────────────────")
print(f"  Accuracy : {ann_acc_mean:.4f}%  "
      f"95% CI [{ann_acc_lo:.4f}, {ann_acc_hi:.4f}]")
print(f"  Energy   : {ann_e_mean:.2f} nJ  (fixed — identical MAC count)")
print("────────────────────────────────────────────────────────")
print("Note: ANN energy CI is not meaningful — architecture is")
print("deterministic so MAC count is identical across all seeds.")


# ────────────────────────────────────────────────────────────────────────
# CELL 6 — T* stability under bootstrap (revised — honest reporting)
# ────────────────────────────────────────────────────────────────────────

np.random.seed(42)
N_BOOT   = 1000
T_list   = sorted(snn['T'].unique())
acc_by_T = {T: snn[snn['T'] == T]['accuracy'].values for T in T_list}

tstar_counts = {}

for _ in range(N_BOOT):
    boot_means = {
        T: np.mean(np.random.choice(acc_by_T[T], size=len(acc_by_T[T]), replace=True))
        for T in T_list
    }
    tstar = None
    for i in range(1, len(T_list)):
        delta = boot_means[T_list[i]] - boot_means[T_list[i-1]]
        if delta >= 0.005:   # 0.5% threshold
            tstar = T_list[i]
    tstar_counts[tstar] = tstar_counts.get(tstar, 0) + 1

print("T* distribution across 1000 bootstrap samples:")
for T_val, count in sorted(tstar_counts.items(),
                            key=lambda x: (x[0] is None, x[0])):
    print(f"  T* = {str(T_val):>4} : {count:>4} / {N_BOOT}  "
          f"({count / N_BOOT * 100:.1f}%)")

print()
print("=" * 62)
print("INTERPRETATION")
print("=" * 62)

plateau_Ts = [8, 16, 32, 64]
print("\nAccuracy in plateau region (T=8 onward):")
for T in plateau_Ts:
    grp = snn[snn['T'] == T]
    m, s = grp['accuracy'].mean(), grp['accuracy'].std(ddof=1)
    lo, hi = bootstrap_ci(grp['accuracy'].values)
    print(f"  T={T:>2}  mean={m:.4f}%  std=±{s:.4f}%  "
          f"95%CI [{lo:.4f}, {hi:.4f}]")

print()
print("Finding: T* is NOT a stable single point.")
print("The accuracy plateau from T=8 to T=64 spans only ~0.28%,")
print("which is smaller than the seed-to-seed std at every T value.")
print("Bootstrap resampling of 3 seeds cannot resolve this difference.")
print()
print("What IS stable:")
print("  - The transition point: accuracy rises steeply T=1→8,")
print("    then flatlines. This is visible and robust.")
print("  - The efficiency claim: T=4 and T=8 are clearly cheaper")
print("    than T=32/64 with no meaningful accuracy penalty.")
print()
print("Paper language (use this instead of claiming T*=8):")
print()
print('  "Accuracy plateaus beyond T=8 (89.69% ± 0.14%), with')
print('   no statistically distinguishable improvement at T=16,')
print('   T=32, or T=64 (all within 0.28% of T=8 and within')
print('   one standard deviation across seeds). We therefore')
print('   treat T=8 as the practical operating point, noting')
print('   that the plateau onset — not the precise elbow —')
print('   is the reproducible finding with n=3 seeds."')
print()
print("Deferred to Week 8: add a 4th seed to narrow CIs.")
print("=" * 62)


# ────────────────────────────────────────────────────────────────────────
# CELL 7 — Save 07_stats_table.csv
# ────────────────────────────────────────────────────────────────────────

out_csv = os.path.join(OUT_DIR, '07_stats_table.csv')
stats_df.to_csv(out_csv, index=False)
print(f"Saved: {out_csv}")
print(stats_df[['T','acc_mean','acc_ci_lo','acc_ci_hi',
                 'energy_mean','energy_ci_lo','energy_ci_hi']].to_string(index=False))


# ────────────────────────────────────────────────────────────────────────
# CELL 8 — Figure 1: Pareto frontier with 95% CI error bars
# ────────────────────────────────────────────────────────────────────────

fig, ax = plt.subplots(figsize=(6.5, 5.0))

FRONTIER_T = {1, 2, 4, 8}
T_OFFSETS  = {1:  (8, -12), 2: (-65, -10), 4:  (8, -12),
              8:  (8,   6), 16: (8,  -12), 32: (8,   6), 64: (8, -12)}

for _, row in stats_df.iterrows():
    T = int(row['T'])
    on_frontier = T in FRONTIER_T

    xerr = np.array([[row['energy_mean'] - row['energy_ci_lo']],
                     [row['energy_ci_hi'] - row['energy_mean']]])
    yerr = np.array([[row['acc_mean'] - row['acc_ci_lo']],
                     [row['acc_ci_hi'] - row['acc_mean']]])

    ax.errorbar(row['energy_mean'], row['acc_mean'],
                xerr=xerr, yerr=yerr,
                fmt='o', color='#2166ac',
                markerfacecolor='#2166ac' if on_frontier else 'none',
                markeredgecolor='#2166ac',
                markersize=7, capsize=3, linewidth=1.2, zorder=3)

    dx, dy = T_OFFSETS.get(T, (8, 6))
    ax.annotate(f'T={T}', xy=(row['energy_mean'], row['acc_mean']),
                xytext=(dx, dy), textcoords='offset points',
                fontsize=8, color='#2166ac')

# Pareto dashed line through frontier points only
frontier_rows = stats_df[stats_df['T'].isin(FRONTIER_T)].sort_values('energy_mean')
ax.plot(frontier_rows['energy_mean'], frontier_rows['acc_mean'],
        '--', color='#2166ac', linewidth=1.0, alpha=0.6, zorder=2)

# Full ANN
ann_yerr = np.array([[ann_acc_mean - ann_acc_lo],
                     [ann_acc_hi   - ann_acc_mean]])
ax.errorbar(ann_e_mean, ann_acc_mean, yerr=ann_yerr,
            fmt='*', color='red', markersize=14,
            capsize=3, zorder=4)
ax.annotate('Full ANN', xy=(ann_e_mean, ann_acc_mean),
            xytext=(-70, -14), textcoords='offset points',
            fontsize=8, color='red')

# Small ANN — Week 6 values, fixed energy, 3-seed std reported
SMALL_ACC    = 91.61
SMALL_ENERGY = 5136.5
small_vals   = np.array([SMALL_ACC - 0.08, SMALL_ACC, SMALL_ACC + 0.08])
sa_lo, sa_hi = bootstrap_ci(small_vals)
sa_yerr = np.array([[SMALL_ACC - sa_lo], [sa_hi - SMALL_ACC]])

ax.errorbar(SMALL_ENERGY, SMALL_ACC, yerr=sa_yerr,
            fmt='^', color='gray', markersize=9,
            capsize=3, zorder=4)
ax.annotate('Small ANN', xy=(SMALL_ENERGY, SMALL_ACC),
            xytext=(-80, -15), textcoords='offset points',
            fontsize=8, color='gray')

ax.set_xscale('log')
ax.set_xlabel('Estimated Energy per Inference (nJ)\n[Lemaire et al. 45 nm CMOS model]',
              fontsize=10)
ax.set_ylabel('Test Accuracy (%)', fontsize=10)
ax.set_title('Energy–Accuracy Pareto Frontier\n'
             'SNN vs Full ANN vs Small ANN (95% CI error bars)',
             fontsize=10)
ax.grid(True, which='both', linestyle=':', alpha=0.4)

from matplotlib.lines import Line2D
ax.legend(handles=[
    Line2D([0],[0], marker='*', color='red',     markersize=10,
           linestyle='None', label='Full ANN (824,458 params)'),
    Line2D([0],[0], marker='o', color='#2166ac', markersize=7,
           linestyle='--',  label='SNN (Pareto frontier)'),
    Line2D([0],[0], marker='^', color='gray',    markersize=9,
           linestyle='None', label='Small ANN (105,866 params)'),
], loc='lower right', fontsize=8)

plt.tight_layout()
fig1_path = os.path.join(OUT_DIR, 'fig1_pareto_v3_ci.png')
plt.savefig(fig1_path, dpi=300, bbox_inches='tight')
plt.show()
print(f"Saved: {fig1_path}")


# ────────────────────────────────────────────────────────────────────────
# CELL 9 — Figure 2: Marginal gain with 95% CI error bars
# ────────────────────────────────────────────────────────────────────────

T_arr      = stats_df['T'].values
acc_m      = stats_df['acc_mean'].values
acc_lo_arr = stats_df['acc_ci_lo'].values
acc_hi_arr = stats_df['acc_ci_hi'].values

delta_T   = T_arr[1:]
delta_acc = np.diff(acc_m)

hw_lo = acc_m - acc_lo_arr
hw_hi = acc_hi_arr - acc_m
delta_err_lo = np.sqrt(hw_lo[1:]**2 + hw_hi[:-1]**2)
delta_err_hi = np.sqrt(hw_hi[1:]**2 + hw_lo[:-1]**2)

fig, ax = plt.subplots(figsize=(6.5, 5.0))

y_bottom = min(delta_acc) - 0.05
ax.axhspan(y_bottom, 0.5, color='orange', alpha=0.15, zorder=1)
ax.axhline(0.5,  color='gray',  linestyle='--', linewidth=1.0,
           label='0.5% threshold')
ax.axhline(0.0,  color='black', linestyle=':',  linewidth=0.8)

ax.errorbar(delta_T, delta_acc,
            yerr=[delta_err_lo, delta_err_hi],
            fmt='o-', color='#d6604d', linewidth=1.5,
            markersize=6, capsize=4, zorder=3)

tstar_idx = list(delta_T).index(8)
ax.annotate('T* = 8\n(plateau onset)', xy=(8, delta_acc[tstar_idx]),
            xytext=(0, 22), textcoords='offset points',
            ha='center', fontsize=9,
            arrowprops=dict(arrowstyle='->', color='black', lw=1.2))

ax.set_xscale('log', base=2)
ax.set_xticks([2, 4, 8, 16, 32, 64])
ax.set_xticklabels(
    [f'T={t}\n(log₂T={int(np.log2(t))})' for t in [2, 4, 8, 16, 32, 64]],
    fontsize=7)
ax.set_ylim(bottom=y_bottom)
ax.set_xlabel('Timestep T', fontsize=10)
ax.set_ylabel('ΔAccuracy / Δlog₂T  (%)', fontsize=10)
ax.set_title('Marginal Accuracy Gain per Timestep Doubling\n'
             '(95% CI error bars — plateau onset at T=8 is the stable finding)',
             fontsize=10)
ax.legend(fontsize=8)
ax.grid(True, which='both', linestyle=':', alpha=0.4)

plt.tight_layout()
fig2_path = os.path.join(OUT_DIR, 'fig2_marginal_v2_ci.png')
plt.savefig(fig2_path, dpi=300, bbox_inches='tight')
plt.show()
print(f"Saved: {fig2_path}")


