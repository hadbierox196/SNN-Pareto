    print(f"  T={int(row['T']):>2}  acc={row['acc_mean']:.2f}%  "
          f"95%CI [{row['acc_ci_lo']:.2f}, {row['acc_ci_hi']:.2f}]  "
          f"energy={row['energy_mean']:.1f} nJ  "
          f"CI [{row['energy_ci_lo']:.1f}, {row['energy_ci_hi']:.1f}]")

print()
print(f"  ANN   acc={ann_acc_mean:.2f}%  "
      f"95%CI [{ann_acc_lo:.2f}, {ann_acc_hi:.2f}]  "
      f"energy={ann_e_mean:.2f} nJ (fixed)")
print()
print("  Small ANN  acc=91.61%  std=±0.08%  energy=5136.5 nJ (fixed)")
print()
print("NOTE: CIs via percentile bootstrap (n_boot=1000, seed=42).")
print("n=3 seeds — intervals are indicative, not statistically definitive.")
print("=" * 62)


