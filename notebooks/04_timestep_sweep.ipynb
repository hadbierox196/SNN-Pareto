import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import matplotlib.patches as mpatches
from matplotlib.gridspec import GridSpec
import io

# ── Data (from your completed sweep) ──────────────────────────
csv_data = """T,seed,accuracy,synops,energy_nj
1,42,80.25,679968.89,611.972
1,123,81.44,922655.95,830.3904
1,7,80.33,723676.63,651.309
2,42,84.55,1964111.77,1767.7006
2,123,84.84,2406410.07,2165.7691
2,7,85.15,2432418.96,2189.1771
4,42,88.43,3537018.3,3183.3165
4,123,88.37,4103739.82,3693.3658
4,7,88.1,3611978.55,3250.7807
8,42,89.66,3891997.37,3502.7976
8,123,89.85,4559785.09,4103.8066
8,7,89.57,4581867.02,4123.6803
16,42,89.16,6134111.55,5520.7004
16,123,89.79,7763186.86,6986.8682
16,7,89.66,7228257.5,6505.4317
32,42,89.64,13247413.55,11922.6722
32,123,90.08,13351498.56,12016.3487
32,7,89.6,14643115.7,13178.8041
64,42,89.8,23101014.97,20790.9135
64,123,89.97,26223910.17,23601.5192
64,7,89.22,24770393.23,22293.3539
nan,42,93.11,4643840,21361.664
nan,123,92.93,4643840,21361.664
nan,7,92.87,4643840,21361.664"""

df = pd.read_csv(io.StringIO(csv_data))

snn_df = df[pd.to_numeric(df['T'], errors='coerce').notna()].copy()
snn_df['T'] = snn_df['T'].astype(float).astype(int)
ann_df = df[pd.to_numeric(df['T'], errors='coerce').isna()].copy()

grouped = snn_df.groupby('T').agg(
    acc_mean=('accuracy', 'mean'),
    acc_std =('accuracy', 'std'),
    eng_mean=('energy_nj', 'mean'),
    eng_std =('energy_nj', 'std'),
    syn_mean=('synops',    'mean'),
    syn_std =('synops',    'std'),
).reset_index()

ann_acc_mean = ann_df['accuracy'].mean()
ann_eng_mean = ann_df['energy_nj'].mean()
ann_acc_std  = ann_df['accuracy'].std()
ANN_MACS     = 4643840
E_MAC        = 4.6e-12

T_vals   = grouped['T'].values
acc_mean = grouped['acc_mean'].values
acc_std  = grouped['acc_std'].values
eng_mean = grouped['eng_mean'].values
eng_std  = grouped['eng_std'].values

# ── Plot 1: Accuracy vs T ──────────────────────────────────────
fig, ax = plt.subplots(figsize=(8, 5))
ax.errorbar(T_vals, acc_mean, yerr=acc_std,
            fmt='o-', capsize=5, capthick=1.5, linewidth=2,
            color='steelblue', label='SNN (mean ± std, 3 seeds)')
ax.axhline(ann_acc_mean, color='tomato', linestyle='--', linewidth=1.8,
           label=f'ANN baseline ({ann_acc_mean:.2f}%)')
ax.fill_between(T_vals, acc_mean - acc_std, acc_mean + acc_std,
                alpha=0.15, color='steelblue')
ax.set_xscale('log', base=2)
ax.set_xticks(T_vals)
ax.get_xaxis().set_major_formatter(plt.ScalarFormatter())
ax.set_xlabel('Timesteps T', fontsize=13)
ax.set_ylabel('Test Accuracy (%)', fontsize=13)
ax.set_title('SNN Accuracy vs Timesteps — Fashion-MNIST', fontsize=14)
ax.legend(fontsize=11)
ax.grid(True, alpha=0.3)
ax.set_ylim(78, 95)
plt.tight_layout()
plt.savefig('plot1_accuracy_vs_T.png', dpi=150)
plt.show()
print("Plot 1 saved")

# ── Plot 2: Energy vs T ────────────────────────────────────────
fig, ax = plt.subplots(figsize=(8, 5))
ax.errorbar(T_vals, eng_mean, yerr=eng_std,
            fmt='s-', capsize=5, capthick=1.5, linewidth=2,
            color='darkorange', label='SNN (mean ± std, 3 seeds)')
ax.axhline(ann_eng_mean, color='tomato', linestyle='--', linewidth=1.8,
           label=f'ANN baseline ({ann_eng_mean:.0f} nJ)')
ax.fill_between(T_vals, eng_mean - eng_std, eng_mean + eng_std,
                alpha=0.15, color='darkorange')
ax.set_xscale('log', base=2)
ax.set_xticks(T_vals)
ax.get_xaxis().set_major_formatter(plt.ScalarFormatter())
ax.set_xlabel('Timesteps T', fontsize=13)
ax.set_ylabel('Energy per Inference (nJ)', fontsize=13)
ax.set_title('SNN Energy vs Timesteps — Fashion-MNIST', fontsize=14)
ax.legend(fontsize=11)
ax.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('plot2_energy_vs_T.png', dpi=150)
plt.show()
print("Plot 2 saved")

# ── Plot 3: Pareto Curve (Energy vs Accuracy) ──────────────────
fig, ax = plt.subplots(figsize=(8, 5))
sc = ax.scatter(eng_mean, acc_mean, c=T_vals, cmap='viridis',
                s=120, zorder=5, label='SNN operating points')
ax.errorbar(eng_mean, acc_mean,
            xerr=eng_std, yerr=acc_std,
            fmt='none', color='gray', alpha=0.4, capsize=3)
for i, T in enumerate(T_vals):
    ax.annotate(f'T={T}',
                xy=(eng_mean[i], acc_mean[i]),
                xytext=(8, 4), textcoords='offset points', fontsize=9)
ax.scatter(ann_eng_mean, ann_acc_mean,
           color='tomato', marker='*', s=300, zorder=6, label='ANN baseline')
ax.annotate('ANN', xy=(ann_eng_mean, ann_acc_mean),
            xytext=(8, -12), textcoords='offset points',
            fontsize=9, color='tomato')
plt.colorbar(sc, ax=ax, label='Timesteps T')
ax.set_xlabel('Energy per Inference (nJ)', fontsize=13)
ax.set_ylabel('Test Accuracy (%)', fontsize=13)
ax.set_title('Pareto Curve: Accuracy vs Energy Trade-off', fontsize=14)
ax.legend(fontsize=11)
ax.grid(True, alpha=0.3)
plt.tight_layout()
plt.savefig('plot3_pareto.png', dpi=150)
plt.show()
print("Plot 3 saved")

# ── Plot 4: Energy Saving Ratio vs T ──────────────────────────
savings = ann_eng_mean / eng_mean
fig, ax = plt.subplots(figsize=(8, 5))
ax.bar(range(len(T_vals)), savings, color='steelblue', alpha=0.8)
ax.axhline(1.0, color='tomato', linestyle='--', linewidth=1.5,
           label='Break-even (1×)')
ax.set_xticks(range(len(T_vals)))
ax.set_xticklabels([f'T={t}' for t in T_vals])
ax.set_ylabel('Energy Saving vs ANN (×)', fontsize=13)
ax.set_title('SNN Energy Saving Ratio vs ANN', fontsize=14)
ax.legend(fontsize=11)
ax.grid(True, alpha=0.3, axis='y')
for i, (s, t) in enumerate(zip(savings, T_vals)):
    ax.text(i, s + 0.05, f'{s:.1f}×', ha='center', fontsize=10)
plt.tight_layout()
plt.savefig('plot4_savings.png', dpi=150)
plt.show()
print("Plot 4 saved")

# ── Summary Table ──────────────────────────────────────────────
print("\n" + "="*75)
print(f"{'T':>6} {'acc_mean':>10} {'acc_std':>8} "
      f"{'energy_mean':>13} {'energy_std':>11} {'saving':>8}")
print("-"*75)
for _, row in grouped.iterrows():
    saving = ann_eng_mean / row['eng_mean']
    print(f"  T={int(row['T']):>2}   "
          f"{row['acc_mean']:>8.2f}%   "
          f"±{row['acc_std']:>5.2f}%   "
          f"{row['eng_mean']:>11.1f} nJ   "
          f"±{row['eng_std']:>7.1f} nJ   "
          f"{saving:>6.1f}×")
print("-"*75)
print(f"  ANN   {ann_acc_mean:>8.2f}%   {'—':>7}    "
      f"{ann_eng_mean:>11.1f} nJ   {'—':>10}   {'1.0×':>6}")
print("="*75)

# ── Key Findings ───────────────────────────────────────────────
plateau_T = T_vals[np.argmax(np.diff(acc_mean) < 0.5)]
best_pareto_idx = np.argmax(acc_mean / eng_mean)
best_pareto_T   = T_vals[best_pareto_idx]
saving_at_8     = ann_eng_mean / grouped.loc[grouped['T']==8, 'eng_mean'].values[0]
acc_gap_at_8    = ann_acc_mean - grouped.loc[grouped['T']==8, 'acc_mean'].values[0]

print("\n── KEY FINDINGS ──────────────────────────────────────────────")
print(f"  Accuracy plateau starts at       : T={plateau_T}")
print(f"  Best Pareto point                : T={best_pareto_T}")
print(f"  Energy saving at T=8 vs ANN      : {saving_at_8:.2f}×")
print(f"  Accuracy gap at T=8 vs ANN       : {acc_gap_at_8:.2f}%")
print(f"  SNN never reaches ANN accuracy   : gap = {ann_acc_mean - acc_mean.max():.2f}% at best T")
print(f"  T=64 energy vs ANN               : {ann_eng_mean/eng_mean[-1]:.2f}× saving")
print("──────────────────────────────────────────────────────────────")
