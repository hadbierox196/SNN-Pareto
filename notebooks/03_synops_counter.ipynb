# ── CELL 0 — Install ─────────────────────────────────────────────
import subprocess
subprocess.run(["pip", "install", "snntorch", "-q"])

# ── CELL 1 — Imports and definitions ─────────────────────────────
import torch
import torch.nn as nn
import snntorch as snn
from snntorch import spikegen
import io

E_AC  = 0.9e-12
E_MAC = 4.6e-12


def count_synops(spk_rec, weight):
    fan_out      = weight.shape[0]
    total_spikes = spk_rec.sum().item()
    return total_spikes * fan_out


def count_synops_conv(spk_rec, conv_layer):
    C_out        = conv_layer.out_channels
    kH, kW       = conv_layer.kernel_size
    fan_out      = C_out * kH * kW
    total_spikes = spk_rec.sum().item()
    return total_spikes * fan_out


def energy_snn(total_synops):
    return total_synops * E_AC


def energy_ann(total_macs):
    return total_macs * E_MAC


def count_ann_macs():
    conv1_macs = 32  * 1  * 3 * 3 * 28 * 28
    conv2_macs = 64  * 32 * 3 * 3 * 14 * 14
    fc1_macs   = 3136 * 256
    fc2_macs   = 256  * 10
    total      = conv1_macs + conv2_macs + fc1_macs + fc2_macs
    return {
        "conv1": conv1_macs,
        "conv2": conv2_macs,
        "fc1"  : fc1_macs,
        "fc2"  : fc2_macs,
        "total": total,
    }


class SNN_Week2(nn.Module):
    def __init__(self, beta=0.9, threshold=1.0):
        super().__init__()
        self.conv1   = nn.Conv2d(1, 32, 3, padding=1)
        self.lif1    = snn.Leaky(beta=beta, threshold=threshold)
        self.pool1   = nn.MaxPool2d(2)
        self.conv2   = nn.Conv2d(32, 64, 3, padding=1)
        self.lif2    = snn.Leaky(beta=beta, threshold=threshold)
        self.pool2   = nn.MaxPool2d(2)
        self.flatten = nn.Flatten()
        self.fc1     = nn.Linear(3136, 256)
        self.lif3    = snn.Leaky(beta=beta, threshold=threshold)
        self.drop    = nn.Dropout(0.3)
        self.fc2     = nn.Linear(256, 10)
        self.lif4    = snn.Leaky(beta=beta, threshold=threshold)

    def forward(self, x_seq):
        T    = x_seq.shape[0]
        mem1 = self.lif1.init_leaky()
        mem2 = self.lif2.init_leaky()
        mem3 = self.lif3.init_leaky()
        mem4 = self.lif4.init_leaky()
        spk1_list, spk2_list, spk3_list, spk4_list = [], [], [], []

        for t in range(T):
            xt         = x_seq[t]
            cur1       = self.conv1(xt)
            spk1, mem1 = self.lif1(cur1, mem1)
            p1         = self.pool1(spk1)
            cur2       = self.conv2(p1)
            spk2, mem2 = self.lif2(cur2, mem2)
            p2         = self.pool2(spk2)
            flat       = self.flatten(p2)
            cur3       = self.fc1(flat)
            spk3, mem3 = self.lif3(cur3, mem3)
            spk3       = self.drop(spk3)
            cur4       = self.fc2(spk3)
            spk4, mem4 = self.lif4(cur4, mem4)
            spk1_list.append(spk1)
            spk2_list.append(spk2)
            spk3_list.append(spk3)
            spk4_list.append(spk4)

        spk_recs = {
            "lif1": torch.stack(spk1_list, dim=0),
            "lif2": torch.stack(spk2_list, dim=0),
            "lif3": torch.stack(spk3_list, dim=0),
            "lif4": torch.stack(spk4_list, dim=0),
        }
        return spk_recs["lif4"], spk_recs


def compute_all_synops(spk_recs, model):
    synops                = {}
    synops["lif1->conv2"] = count_synops_conv(spk_recs["lif1"], model.conv2)
    lif2_flat             = spk_recs["lif2"].flatten(start_dim=2)
    synops["lif2->fc1"]   = count_synops(lif2_flat, model.fc1.weight)
    synops["lif3->fc2"]   = count_synops(spk_recs["lif3"], model.fc2.weight)
    synops["lif4->out"]   = 0.0
    synops["total"]       = sum(synops.values())
    return synops


print("✅ Cell 1 complete — all definitions loaded.")


# ── CELL 2 — Toy network validation ──────────────────────────────
HAND_CALC   = 6
toy_weight  = torch.ones(3, 2)
toy_spk     = torch.ones(1, 1, 2)
code_result = count_synops(toy_spk, toy_weight)

print("═" * 50)
print("TOY NETWORK VALIDATION")
print("═" * 50)
print(f"  Hand calculation : {HAND_CALC}")
print(f"  Code output      : {code_result}")
print(f"  Match            : {'✅ PASS' if code_result == HAND_CALC else '❌ FAIL'}")
print("═" * 50)

log_text = f"""TOY NETWORK VALIDATION LOG
===========================
Network      : Linear(2 -> 3)
Input        : all-ones spike tensor [T=1, B=1, N_pre=2]
Weight shape : [N_post=3, N_pre=2]

Hand Calculation:
  total_spikes = T x B x N_pre = 1 x 1 x 2 = 2
  fan_out      = N_post = 3
  SynOps       = total_spikes x fan_out = 2 x 3 = 6

Code Output  : {code_result}
Match        : {'PASS' if code_result == HAND_CALC else 'FAIL'}
"""
print(log_text)


# ── CELL 3 — Load checkpoint + forward pass + SynOps ─────────────
from google.colab import files

print("Upload snn_T32_init.pt from your machine...")
uploaded = files.upload()

T      = 32
B      = 128
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")

model           = SNN_Week2(beta=0.9, threshold=1.0).to(device)
checkpoint_name = list(uploaded.keys())[0]
checkpoint      = torch.load(io.BytesIO(uploaded[checkpoint_name]), map_location=device)
model.load_state_dict(checkpoint["model_state_dict"])
model.eval()

print(f"✅ Loaded checkpoint : {checkpoint_name}")
print(f"   Saved at epoch    : {checkpoint['epoch']}")
print(f"   Val accuracy      : {checkpoint['val_acc']:.2f}%")

# NOTE: using torch.rand noise input
# Replace with real Fashion-MNIST dataloader batch in Week 4
x_raw = torch.rand(B, 1, 28, 28).to(device)
x_seq = spikegen.rate(x_raw, num_steps=T)

with torch.no_grad():
    _, spk_recs = model(x_seq)

synops = compute_all_synops(spk_recs, model)

print()
print("═" * 50)
print("SNN SYNOPS AT T=32")
print("═" * 50)
for layer, val in synops.items():
    print(f"  {layer:<20s}: {val:>15,.0f}")
print("═" * 50)

print()
print("═" * 50)
print("SPIKE RATE CHECK  (compare to Week 2 epoch log)")
print("═" * 50)
print(f"  lif1 : {spk_recs['lif1'].mean().item():.4f}  (Week 2: 0.089–0.107)")
print(f"  lif2 : {spk_recs['lif2'].mean().item():.4f}  (Week 2: 0.022–0.049)")
print(f"  lif3 : {spk_recs['lif3'].mean().item():.4f}  (Week 2: 0.059–0.121)")
print(f"  lif4 : {spk_recs['lif4'].mean().item():.4f}  (Week 2: 0.028–0.091)")
print("═" * 50)


# ── CELL 4 — ANN MAC count ───────────────────────────────────────
macs = count_ann_macs()

print("═" * 50)
print("ANN MAC COUNT (per sample)")
print("═" * 50)
for layer, val in macs.items():
    print(f"  {layer:<8s}: {val:>15,}")
print("═" * 50)


# ── CELL 5 — Energy comparison table ─────────────────────────────
ann_macs           = macs["total"]
snn_ops_per_sample = synops["total"] / B

ann_energy_nJ = energy_ann(ann_macs) * 1e9
snn_energy_nJ = energy_snn(snn_ops_per_sample) * 1e9
efficiency    = ann_energy_nJ / snn_energy_nJ if snn_energy_nJ > 0 else float("inf")

print("═" * 65)
print(f"{'ENERGY COMPARISON (per sample, T=32)':^65}")
print("═" * 65)
print(f"  {'Metric':<35} {'ANN':>12}  {'SNN':>12}")
print("─" * 65)
print(f"  {'Operations (MACs / SynOps)':<35} {ann_macs:>12,}  {snn_ops_per_sample:>12,.0f}")
print(f"  {'Energy (nJ)':<35} {ann_energy_nJ:>12.4f}  {snn_energy_nJ:>12.4f}")
print(f"  {'SNN saving vs ANN':<35} {'':>12}  {efficiency:>11.2f}x")
print("═" * 65)
print()
print("  Lemaire constants: E_AC = 0.9 pJ | E_MAC = 4.6 pJ | 45nm node")
print()
print("  NOTE: computed on random noise input — recompute on real")
print("  Fashion-MNIST test batch in Week 4 for paper figures.")


# ── CELL 6 — Sanity check: 50% spike zeroing ─────────────────────
spk_recs_zeroed       = {k: v.clone() for k, v in spk_recs.items()}
mask                  = (torch.rand_like(spk_recs_zeroed["lif3"]) > 0.5).float()
spk_recs_zeroed["lif3"] = spk_recs_zeroed["lif3"] * mask

synops_zeroed = compute_all_synops(spk_recs_zeroed, model)
original      = synops["lif3->fc2"]
zeroed        = synops_zeroed["lif3->fc2"]
decreased     = zeroed < original

print("═" * 50)
print("SANITY CHECK — 50% spike zeroing")
print("═" * 50)
print(f"  lif3->fc2 SynOps (original) : {original:>12,.0f}")
print(f"  lif3->fc2 SynOps (50% zero) : {zeroed:>12,.0f}")
print(f"  Decreased                   : {'✅ PASS' if decreased else '❌ FAIL'}")
print(f"  Reduction                   : {(1 - zeroed/original)*100:.1f}%  (expect ~50%)")
print("═" * 50)
